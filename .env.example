NODE_ENV=development
# Combined process: both true. Prefer `npm run start:api` / `start:indexer` for split roles.
ENABLE_INDEXER=true
ENABLE_BALANCE_WORKER=true
BALANCE_REFRESH_INTERVAL_MS=2000
BALANCE_REFRESH_BATCH=100
BALANCE_REFRESH_CONCURRENCY=4
PORT=3000

DATABASE_URL=postgres://etherscope:etherscope@localhost:5432/etherscope
DB_POOL_MAX=10
STATEMENT_TIMEOUT_MS=30000

RPC_URL=http://127.0.0.1:8545
CONFIRMATION_DEPTH=2
BATCH_SIZE_LIVE=2
BATCH_SIZE_CATCHUP=40
POLL_INTERVAL_MS=1000

# Comma-separated ERC-20 addresses (filled after seed / deploy)
TOKEN_ADDRESSES=

SEED_DEFAULT_COUNT=1000
MAX_SEED_COUNT=100000
